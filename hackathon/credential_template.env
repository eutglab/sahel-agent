# =============================================================================
# HACKATHON CREDENTIAL TEMPLATE
# Copy the lines you need into the project-root `.env` (NOT this file).
# `.env` is gitignored. Never commit real values.
# =============================================================================

# Flip the app into hackathon mode (external tools/providers activable, verbose)
ENVIRONMENT=hackathon
DEMO_MODE=false

# --- LLM (pick ONE) ----------------------------------------------------------
# Anthropic
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Generic OpenAI-compatible endpoint provided by organisers
# LLM_PROVIDER=hackathon
# HACKATHON_LLM_BASE_URL=
# HACKATHON_LLM_API_KEY=
# HACKATHON_LLM_MODEL=

# --- Weather ---------------------------------------------------------------
# Keep open_meteo (free) unless organisers provide a weather API.
WEATHER_PROVIDER=open_meteo
WEATHER_FALLBACK_CHAIN=hackathon,open_meteo,local,mock
HACKATHON_WEATHER_BASE_URL=
HACKATHON_WEATHER_API_KEY=

# --- Vision --------------------------------------------------------------
VISION_PROVIDER=llm_vision
VISION_FALLBACK_CHAIN=hackathon,llm_vision,local_heuristic,mock

# --- Recommendation ----------------------------------------------------------
RECOMMENDATION_PROVIDER=llm
RECOMMENDATION_FALLBACK_CHAIN=hackathon,llm,template

# --- Optional tools to enable if organisers give you an API -----------------
TOOL_WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
TOOL_FILE_ANALYSIS_ENABLED=false
TOOL_NOTIFICATION_ENABLED=false
