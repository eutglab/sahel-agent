# =============================================================================
# SAHEL Agent — configuration template
# Copy to `.env` and fill only what you need. `.env` is gitignored.
# The project runs fully with ZERO values set (DEMO_MODE defaults to true).
# =============================================================================

# --- Master switch --------------------------------------------------------------
# demo       : everything mocked/local, no network, no keys (default)
# hackathon  : external tools/providers activable, detailed logs, health checks
# real       : use configured real providers, fall back gracefully on failure
ENVIRONMENT=demo

# When true, the agent never requires an API key and prefers local/mock providers.
DEMO_MODE=true

# One-click judge demo: the UI preloads the strongest scenario so the only
# action needed on stage is pressing ANALYZE.
DEMO_JUDGE_MODE=false
DEMO_JUDGE_SCENARIO=multiple_risks

# --- LLM provider -------------------------------------------------------------
# mock | anthropic | openai | hackathon
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Generic hackathon LLM endpoint (OpenAI-compatible chat completions)
HACKATHON_LLM_BASE_URL=
HACKATHON_LLM_API_KEY=
HACKATHON_LLM_MODEL=

# --- Weather provider ---------------------------------------------------------
# open_meteo (real, keyless) | local | mock | hackathon
WEATHER_PROVIDER=local
WEATHER_FALLBACK_CHAIN=open_meteo,local,mock
HACKATHON_WEATHER_BASE_URL=
HACKATHON_WEATHER_API_KEY=

# --- Vision provider --------------------------------------------------------
# mock | local_heuristic | llm_vision | hackathon
VISION_PROVIDER=local_heuristic
VISION_FALLBACK_CHAIN=llm_vision,local_heuristic,mock

# --- Recommendation provider -----------------------------------------------
# template (deterministic) | llm | hackathon
RECOMMENDATION_PROVIDER=template
RECOMMENDATION_FALLBACK_CHAIN=llm,template

# --- Web search (evidence grounding) ----------------------------------------
# exa (real, keyed) | mock (offline sample data)
# Called only when the agent detects a moderate/high risk driver — never a
# generic lookup. Get a key at https://exa.ai
WEB_SEARCH_PROVIDER=exa
WEB_SEARCH_FALLBACK_CHAIN=exa,mock
EXA_API_KEY=

# --- Optional / integration-ready tools (disabled by default) ---------------
TOOL_VISION_ENABLED=true
TOOL_SENSORS_ENABLED=true
TOOL_WEATHER_ENABLED=true
TOOL_RISK_ENABLED=true
TOOL_RECOMMENDATION_ENABLED=true
TOOL_WEB_SEARCH_ENABLED=true
TOOL_FILE_ANALYSIS_ENABLED=false
TOOL_NOTIFICATION_ENABLED=false

# --- Runtime limits --------------------------------------------------------
MAX_UPLOAD_MB=8
TOOL_TIMEOUT_SECONDS=12
AGENT_MAX_ITERATIONS=6

# --- Storage --------------------------------------------------------------
DB_PATH=data/runs.sqlite3
LOG_DIR=logs
